# Proxmox Configuration
PROXMOX_HOST=192.168.1.100
PROXMOX_API_PORT=8006
PROXMOX_NODE=pve
PROXMOX_USER=root@pam
PROXMOX_API_TOKEN_ID=github-actions@pve!deploy
PROXMOX_API_TOKEN_SECRET=your-api-token-secret-here

# Domain Configuration
PANEL_DOMAIN=panel.trostrum.com
WINGS_DOMAIN=node.trostrum.com

# Network Configuration
NETWORK_BRIDGE=vmbr1
NETWORK_SUBNET=10.0.0.0/24
PANEL_LXC_IP=10.0.0.2/24
WINGS_LXC_IP=10.0.0.3/24
GATEWAY_IP=10.0.0.1

# LXC Container IDs
PANEL_LXC_ID=200
WINGS_LXC_ID=201

# Pterodactyl Panel Configuration
PANEL_DB_HOST=localhost
PANEL_DB_PORT=3306
PANEL_DB_NAME=pterodactyl
PANEL_DB_USER=pterodactyl
PANEL_DB_PASSWORD=change_me_strong_password

# Panel Application
PANEL_APP_ENV=production
PANEL_APP_DEBUG=false
PANEL_APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key:generate
PANEL_APP_URL=https://panel.trostrum.com

# Panel Admin User
PANEL_ADMIN_EMAIL=admin@trostrum.com
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=change_me_admin_password
PANEL_ADMIN_FIRSTNAME=Admin
PANEL_ADMIN_LASTNAME=User

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SSL/TLS Configuration
CERTBOT_EMAIL=admin@trostrum.com
SSL_PROVIDER=certbot  # certbot or manual

# Wings Configuration
WINGS_PORT=8080
WINGS_SFTP_PORT=2022
WINGS_DEBUG=false

# Game Server Port Range
GAME_PORT_START=7777
GAME_PORT_END=7877

# LXC Resource Allocation
PANEL_CORES=2
PANEL_MEMORY=4096
PANEL_SWAP=512
PANEL_DISK_SIZE=20

WINGS_CORES=4
WINGS_MEMORY=8192
WINGS_SWAP=1024
WINGS_DISK_SIZE=50

# LXC Template
LXC_TEMPLATE=local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst
LXC_STORAGE=local-lvm

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_STORAGE_PATH=/var/backups/pterodactyl
BACKUP_RETENTION_DAYS=7
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Monitoring
MONITOR_ENABLED=true
MONITOR_CHECK_INTERVAL=300  # seconds

# Environment
ENVIRONMENT=production  # production, staging, dev
